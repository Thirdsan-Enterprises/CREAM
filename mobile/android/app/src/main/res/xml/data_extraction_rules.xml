<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the app's saved data out of cloud backup and phone-to-phone transfer.
  The sign-in token is encrypted with a key that lives only in the phone's
  Keystore. If the data were restored onto another phone, or after a reinstall,
  the data would come back without its key and could not be read.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
